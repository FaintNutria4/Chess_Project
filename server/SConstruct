#!/usr/bin/env python

env = Environment()

if env["PLATFORM"] == "win32":
    env.Append(CCFLAGS=["/std:c++17", "/EHsc", "/D_WIN32_WINNT=0x0A00"])
    env.Append(LIBS=["ws2_32", "mswsock", "bcrypt"])
else:
    env.Append(CCFLAGS=["-std=c++17"])
    env.Append(LIBS=["pthread"])

env.Append(CPPPATH=["external/boost_1_92_0"])

env.Tool("compilation_db")
compdb = env.CompilationDatabase("compile_commands.json")

program = env.Program("chess_server", source=["ChessServer.cpp"])

Default([program, compdb])